                        <span
                            style='font-family: 宋体'>论文选题来源</span>
                    </p>
                </td>
                <td width="112" colspan="2" style='width: 83.8pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 0cm 0cm 0cm; height: 1.0cm'>
                    <p class="MsoNormal" align="center" style='text-align: center; line-height: 130%'>
                        <span
                            style='font-family: 宋体;'>学校自选项目</span>
                    </p>
                </td>
                <td width="88" colspan="2" style='width: 65.85pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 1.0cm'>
